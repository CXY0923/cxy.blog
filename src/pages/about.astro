---
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = ['TypeScript', 'Astro', 'React', 'Node.js', 'Rust', 'WebGPU'];
const email = '19516698519@163.com';
const wechatId = 'cxy0923nju';
const github = 'https://github.com/CXY0923';
const linkCls = 'text-on-surface-variant transition-colors hover:text-secondary';
---

<BaseLayout title="ABOUT · NEON_LOG" description="关于 SYS_ADMIN_01。">
  <div class="mx-auto max-w-3xl">
    <div class="glass-panel corner-bracket rounded-lg p-8 text-center md:p-12">
      <div class="glow-text mx-auto mb-4 flex h-24 w-24 items-center justify-center rounded-full border-2 border-primary bg-surface-container font-display text-3xl font-bold text-primary">
        C
      </div>
      <h1 class="font-display text-3xl font-extrabold text-on-surface">SYS_ADMIN_01</h1>
      <p class="mt-1 font-mono text-xs uppercase tracking-widest text-primary">Lead Architect // 赛博架构师</p>
      <p class="mx-auto mt-6 max-w-xl text-balance leading-loose tracking-wide text-on-surface-variant">
        我是蔡兴艺,南京大学25级软件工程学生,会在这里记录课程笔记,项目开发,偶尔会有记录点人生感想。
      </p>
      <p class="mx-auto mt-4 max-w-xl leading-loose tracking-wide text-on-surface-variant">联系通过 GitHub,邮件,微信联系</p>
    </div>

    <!-- 盒子只留给身份牌,其余信息用细线分节,避免卡片泛滥 -->
    <section class="mt-12 border-t border-outline-variant pt-8">
      <h2 class="font-mono text-sm font-bold uppercase tracking-widest text-secondary">SKILL_MATRIX</h2>
      <div class="mt-5 flex flex-wrap gap-2">
        {
          skills.map((s) => (
            <span class="inline-flex items-center rounded-full border border-secondary/30 bg-surface-container px-3 py-1 font-mono text-xs text-secondary">
              {s}
            </span>
          ))
        }
      </div>
    </section>

    <section class="mt-8 border-t border-outline-variant pt-8">
      <h2 class="font-mono text-sm font-bold uppercase tracking-widest text-secondary">CONTACT_CHANNELS</h2>
      <div class="mt-5 flex flex-wrap gap-6 font-mono text-sm uppercase tracking-widest">
        <a href={github} target="_blank" rel="noopener noreferrer" class={linkCls}>
          GITHUB
        </a>
        <button type="button" data-copy={email} class={`cursor-pointer ${linkCls}`}>
          <span data-label>EMAIL</span>
        </button>
        <button type="button" data-copy={wechatId} class={`cursor-pointer ${linkCls}`}>
          <span data-label>WECHAT</span>
        </button>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  /* 点击复制:成功后标签变 COPIED ✓(2s 还原);clipboard API 不可用时退回 execCommand */
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.append(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-label]')!;
    const original = label.textContent;
    let timer: ReturnType<typeof setTimeout> | undefined;
    btn.addEventListener('click', async () => {
      const ok = await copyText(btn.dataset.copy ?? '');
      label.textContent = ok ? 'COPIED ✓' : 'COPY_FAILED';
      label.classList.toggle('text-secondary', ok);
      clearTimeout(timer);
      timer = setTimeout(() => {
        label.textContent = original;
        label.classList.remove('text-secondary');
      }, 2000);
    });
  });
</script>
