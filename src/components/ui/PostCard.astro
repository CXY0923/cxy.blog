---
interface Props {
  title: string;
  href: string;
  description: string;
  date: string;
  tags?: string[];
  /** 额外的筛选属性(逗号分隔),透传到 data-tags,Task 8 筛选用 */
  dataTags?: string;
}
const { title, href, description, date, tags = [], dataTags } = Astro.props;
---

<!-- 扁平日志行:内容流不装盒(玻璃盒只留给常驻家具),细线分隔,hover 亮行 + 终端提示符 -->
<article
  data-note-card
  data-tags={dataTags ?? tags.join(',')}
  class="group -mx-3 border-b border-outline-variant/60 px-3 py-5 transition-colors hover:bg-surface-container/30"
>
  <div class="mb-1.5 flex items-center justify-between gap-3">
    {
      tags.length > 0 && (
        <span class="rounded border border-outline-variant px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-outline">
          {tags[0]}
        </span>
      )
    }
    <span class="ml-auto font-mono text-xs text-secondary/80">{date}</span>
  </div>
  <h3 class="font-display text-lg font-bold text-on-surface transition-colors group-hover:text-primary">
    <a href={href} class="flex items-baseline">
      <span
        aria-hidden="true"
        class="inline-block w-0 overflow-hidden whitespace-nowrap font-mono text-sm font-normal text-secondary transition-all duration-200 group-hover:mr-1.5 group-hover:w-4 motion-reduce:hidden"
      >
        &gt;
      </span>
      {title}
    </a>
  </h3>
  <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-on-surface-variant">{description}</p>
</article>
